<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:scrollbars="none"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="48dp"
        android:paddingBottom="32dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/demo_title"
            android:textColor="@color/white"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/demo_subtitle"
            android:textColor="@color/white_50"
            android:textSize="12sp" />

        <!-- ================= viền gradient, ruột xuyên thấu ================= -->

        <TextView
            style="@style/SectionLabel"
            android:text="@string/section_hero" />

        <!-- FrameLayout này giả làm "ảnh nền". AuroraView bên trong KHÔNG set aurora_fillColors
             ⇒ ruột trong suốt, nhìn thẳng xuyên qua thấy các mảng màu phía sau, trong khi viền
             vẫn là gradient thật. Bấm "Bật / tắt ruột" để so sánh với lúc có nền che. -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="230dp"
            android:background="@drawable/bg_photo">

            <vn.minh_nguyen.vkey.gradient.ui.AuroraView
                android:id="@+id/hero"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_margin="18dp"
                app:aurora_cornerRadius="28dp"
                app:aurora_strokeColors="@array/hero_stroke"
                app:aurora_strokeOrientation="top_bottom"
                app:aurora_strokeWidth="5dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvFillMode"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:shadowColor="#CC000000"
                        android:shadowDx="0"
                        android:shadowDy="1"
                        android:shadowRadius="6"
                        android:textColor="@color/white"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        tools:text="Ruột: XUYÊN THẤU (không set fillColors)" />

                    <TextView
                        android:id="@+id/tvStroke"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:shadowColor="#CC000000"
                        android:shadowDx="0"
                        android:shadowDy="1"
                        android:shadowRadius="6"
                        android:textColor="@color/white"
                        android:textSize="15sp"
                        tools:text="Viền ↓ top_bottom" />

                    <TextView
                        android:id="@+id/tvFillDir"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:shadowColor="#CC000000"
                        android:shadowDx="0"
                        android:shadowDy="1"
                        android:shadowRadius="6"
                        android:textColor="@color/white"
                        android:textSize="15sp"
                        tools:text="Nền — không có" />
                </LinearLayout>
            </vn.minh_nguyen.vkey.gradient.ui.AuroraView>
        </FrameLayout>

        <vn.minh_nguyen.vkey.gradient.ui.AuroraView
            android:id="@+id/btnFillMode"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="12dp"
            android:clickable="true"
            android:focusable="true"
            app:aurora_pill="true"
            app:aurora_strokeWidth="2dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="@string/btn_fill_mode"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:textStyle="bold" />
        </vn.minh_nguyen.vkey.gradient.ui.AuroraView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <vn.minh_nguyen.vkey.gradient.ui.AuroraView
                android:id="@+id/btnStroke"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                app:aurora_pill="true"
                app:aurora_strokeColors="@array/hero_stroke"
                app:aurora_strokeOrientation="top_bottom"
                app:aurora_strokeWidth="2dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="@string/btn_stroke"
                    android:textColor="@color/white"
                    android:textSize="13sp" />
            </vn.minh_nguyen.vkey.gradient.ui.AuroraView>

            <vn.minh_nguyen.vkey.gradient.ui.AuroraView
                android:id="@+id/btnFill"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                app:aurora_pill="true"
                app:aurora_strokeColors="@array/hero_fill_solid"
                app:aurora_strokeOrientation="left_right"
                app:aurora_strokeWidth="2dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="@string/btn_fill"
                    android:textColor="@color/white"
                    android:textSize="13sp" />
            </vn.minh_nguyen.vkey.gradient.ui.AuroraView>
        </LinearLayout>

        <TextView
            android:id="@+id/tvStrokeWidth"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textColor="@color/white_70"
            android:textSize="12sp"
            tools:text="aurora_strokeWidth: 5 dp" />

        <SeekBar
            android:id="@+id/seekStroke"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="16"
            android:progress="5" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:lineSpacingExtra="3dp"
            android:text="@string/section_why"
            android:textColor="@color/white_50"
            android:textSize="12sp" />

        <!-- ================= pill ================= -->

        <TextView
            style="@style/SectionLabel"
            android:text="@string/section_pill" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <vn.minh_nguyen.vkey.gradient.ui.AuroraView
                android:layout_width="56dp"
                android:layout_height="56dp"
                app:aurora_pill="true">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:padding="16dp"
                    android:src="@drawable/ic_search" />
            </vn.minh_nguyen.vkey.gradient.ui.AuroraView>

            <vn.minh_nguyen.vkey.gradient.ui.AuroraView
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_marginStart="12dp"
                app:aurora_orientation="top_bottom"
                app:aurora_pill="true"
                app:aurora_strokeWidth="2dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:padding="16dp"
                    android:src="@drawable/ic_star" />
            </vn.minh_nguyen.vkey.gradient.ui.AuroraView>

            <vn.minh_nguyen.vkey.gradient.ui.AuroraView
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_marginStart="12dp"
                app:aurora_fillColors="@array/card_fill"
                app:aurora_pill="true">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:padding="16dp"
                    android:src="@drawable/ic_chat" />
            </vn.minh_nguyen.vkey.gradient.ui.AuroraView>
        </LinearLayout>

        <!-- ================= CTA ================= -->

        <TextView
            style="@style/SectionLabel"
            android:text="@string/section_cta" />

        <!-- Nền chạy ngang, viền trắng chuyển từ trong suốt → đặc theo chiều DỌC:
             mép trên nhạt, mép dưới sáng — kiểu viền "bevel" hay gặp ở nút premium -->
        <vn.minh_nguyen.vkey.gradient.ui.AuroraView
            android:layout_width="match_parent"
            android:layout_height="52dp"
            app:aurora_fillColors="@array/cta_fill"
            app:aurora_fillOrientation="left_right"
            app:aurora_pill="true"
            app:aurora_strokeColors="@array/cta_stroke"
            app:aurora_strokeOrientation="top_bottom"
            app:aurora_strokeWidth="2dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="@string/cta_label"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:textStyle="bold" />
        </vn.minh_nguyen.vkey.gradient.ui.AuroraView>

        <!-- ================= card ================= -->

        <TextView
            style="@style/SectionLabel"
            android:text="@string/section_card" />

        <vn.minh_nguyen.vkey.gradient.ui.AuroraView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:aurora_clipContent="true"
            app:aurora_cornerRadius="24dp"
            app:aurora_fillColors="@array/card_fill"
            app:aurora_orientation="top_left_bottom_right"
            app:aurora_strokeColors="@array/card_stroke">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/card_title"
                    android:textColor="@color/white"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:lineSpacingExtra="3dp"
                    android:text="@string/card_desc"
                    android:textColor="@color/white_70"
                    android:textSize="13sp" />

                <!-- Aurora lồng trong Aurora -->
                <vn.minh_nguyen.vkey.gradient.ui.AuroraView
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginTop="16dp"
                    app:aurora_pill="true">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:paddingStart="20dp"
                        android:paddingEnd="20dp"
                        android:text="@string/card_nested"
                        android:textColor="@color/white"
                        android:textSize="13sp" />
                </vn.minh_nguyen.vkey.gradient.ui.AuroraView>
            </LinearLayout>
        </vn.minh_nguyen.vkey.gradient.ui.AuroraView>

        <!-- ================= 3 trạng thái ================= -->

        <TextView
            style="@style/SectionLabel"
            android:text="@string/section_states" />

        <vn.minh_nguyen.vkey.gradient.ui.AuroraView
            android:layout_width="match_parent"
            android:layout_height="60dp"
            app:aurora_cornerRadius="18dp"
            app:aurora_fillColors="@array/item_selected_fill"
            app:aurora_fillOrientation="top_bottom"
            app:aurora_strokeColors="@array/item_selected_stroke"
            app:aurora_strokeOrientation="left_right">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:text="@string/item_selected"
                android:textColor="@color/white"
                android:textSize="14sp" />
        </vn.minh_nguyen.vkey.gradient.ui.AuroraView>

        <!-- Viền 1 màu: library tự nhân đôi thành gradient phẳng, không crash -->
        <vn.minh_nguyen.vkey.gradient.ui.AuroraView
            android:id="@+id/itemIdle"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="10dp"
            android:clickable="true"
            android:focusable="true"
            app:aurora_cornerRadius="18dp"
            app:aurora_strokeColors="@array/item_idle_stroke">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:text="@string/item_idle"
                android:textColor="@color/white_70"
                android:textSize="14sp" />
        </vn.minh_nguyen.vkey.gradient.ui.AuroraView>

        <vn.minh_nguyen.vkey.gradient.ui.AuroraView
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="10dp"
            app:aurora_cornerRadius="18dp"
            app:aurora_strokeColors="@array/item_disabled_stroke">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:text="@string/item_disabled"
                android:textColor="@color/white_50"
                android:textSize="14sp" />
        </vn.minh_nguyen.vkey.gradient.ui.AuroraView>
    </LinearLayout>
</ScrollView>
