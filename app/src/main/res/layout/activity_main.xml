<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:scrollbars="none"
    tools:context=".MainActivity">

    <LinearLayout
        android:id="@+id/auroraRoot"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="48dp"
        android:paddingBottom="32dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/demo_title"
            android:textColor="@color/white"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/demo_subtitle"
            android:textColor="@color/white_50"
            android:textSize="12sp" />

        <!-- ================= pill ================= -->

        <TextView
            style="@style/SectionLabel"
            android:text="@string/section_pill" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <vn.minh_nguyen.vkey.gradient.ui.AuroraView
                android:layout_width="56dp"
                android:layout_height="56dp"
                app:aurora_pill="true">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:padding="16dp"
                    android:src="@drawable/ic_search" />
            </vn.minh_nguyen.vkey.gradient.ui.AuroraView>

            <vn.minh_nguyen.vkey.gradient.ui.AuroraView
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_marginStart="12dp"
                app:aurora_orientation="top_bottom"
                app:aurora_pill="true"
                app:aurora_strokeWidth="2dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:padding="16dp"
                    android:src="@drawable/ic_star" />
            </vn.minh_nguyen.vkey.gradient.ui.AuroraView>

            <vn.minh_nguyen.vkey.gradient.ui.AuroraView
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_marginStart="12dp"
                app:aurora_fillColors="@array/card_fill"
                app:aurora_pill="true">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:padding="16dp"
                    android:src="@drawable/ic_chat" />
            </vn.minh_nguyen.vkey.gradient.ui.AuroraView>
        </LinearLayout>

        <!-- ================= CTA ================= -->

        <TextView
            style="@style/SectionLabel"
            android:text="@string/section_cta" />

        <vn.minh_nguyen.vkey.gradient.ui.AuroraView
            android:layout_width="match_parent"
            android:layout_height="52dp"
            app:aurora_fillColors="@array/cta_fill"
            app:aurora_fillOrientation="left_right"
            app:aurora_pill="true"
            app:aurora_strokeColors="@array/cta_stroke"
            app:aurora_strokeOrientation="top_bottom">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="@string/cta_label"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:textStyle="bold" />
        </vn.minh_nguyen.vkey.gradient.ui.AuroraView>

        <!-- ================= card ================= -->

        <TextView
            style="@style/SectionLabel"
            android:text="@string/section_card" />

        <vn.minh_nguyen.vkey.gradient.ui.AuroraView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:aurora_clipContent="true"
            app:aurora_cornerRadius="24dp"
            app:aurora_fillColors="@array/card_fill"
            app:aurora_orientation="top_left_bottom_right"
            app:aurora_strokeColors="@array/card_stroke">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/card_title"
                    android:textColor="@color/white"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:lineSpacingExtra="3dp"
                    android:text="@string/card_desc"
                    android:textColor="@color/white_70"
                    android:textSize="13sp" />

                <!-- Aurora lồng trong Aurora: nút bên trong cũng chỉ là một AuroraView -->
                <vn.minh_nguyen.vkey.gradient.ui.AuroraView
                    android:id="@+id/btnOrientation"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginTop="16dp"
                    android:clickable="true"
                    android:focusable="true"
                    app:aurora_pill="true">

                    <TextView
                        android:id="@+id/tvOrientation"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:paddingStart="20dp"
                        android:paddingEnd="20dp"
                        android:textColor="@color/white"
                        android:textSize="13sp"
                        tools:text="Hướng gradient: left_right" />
                </vn.minh_nguyen.vkey.gradient.ui.AuroraView>
            </LinearLayout>
        </vn.minh_nguyen.vkey.gradient.ui.AuroraView>

        <!-- ================= 3 trạng thái ================= -->

        <TextView
            style="@style/SectionLabel"
            android:text="@string/section_states" />

        <vn.minh_nguyen.vkey.gradient.ui.AuroraView
            android:layout_width="match_parent"
            android:layout_height="60dp"
            app:aurora_cornerRadius="18dp"
            app:aurora_fillColors="@array/item_selected_fill"
            app:aurora_strokeColors="@array/item_selected_stroke">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:text="@string/item_selected"
                android:textColor="@color/white"
                android:textSize="14sp" />
        </vn.minh_nguyen.vkey.gradient.ui.AuroraView>

        <!-- Viền 1 màu: library tự nhân đôi thành gradient phẳng, không crash -->
        <vn.minh_nguyen.vkey.gradient.ui.AuroraView
            android:id="@+id/itemIdle"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="10dp"
            android:clickable="true"
            android:focusable="true"
            app:aurora_cornerRadius="18dp"
            app:aurora_strokeColors="@array/item_idle_stroke">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:text="@string/item_idle"
                android:textColor="@color/white_70"
                android:textSize="14sp" />
        </vn.minh_nguyen.vkey.gradient.ui.AuroraView>

        <vn.minh_nguyen.vkey.gradient.ui.AuroraView
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="10dp"
            app:aurora_cornerRadius="18dp"
            app:aurora_strokeColors="@array/item_disabled_stroke">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:text="@string/item_disabled"
                android:textColor="@color/white_50"
                android:textSize="14sp" />
        </vn.minh_nguyen.vkey.gradient.ui.AuroraView>

        <!-- ================= playground ================= -->

        <TextView
            style="@style/SectionLabel"
            android:text="@string/section_playground" />

        <vn.minh_nguyen.vkey.gradient.ui.AuroraView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:aurora_cornerRadius="24dp"
            app:aurora_strokeColors="@array/card_stroke">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:id="@+id/tvStroke"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/white_70"
                    android:textSize="12sp"
                    tools:text="strokeWidth: 1 dp" />

                <SeekBar
                    android:id="@+id/seekStroke"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="8"
                    android:progress="1" />
            </LinearLayout>
        </vn.minh_nguyen.vkey.gradient.ui.AuroraView>
    </LinearLayout>
</ScrollView>
