<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="white">#FFFFFFFF</color>
    <color name="white_70">#B3FFFFFF</color>
    <color name="white_50">#80FFFFFF</color>

    <!-- Nền demo: gần đen, hơi ngả tím — gradient nổi nhất trên nền tối -->
    <color name="backdrop_start">#171021</color>
    <color name="backdrop_end">#08060C</color>

    <color name="brand_orange">#7FD66341</color>
    <color name="brand_pink">#7FB7528D</color>
    <color name="brand_violet">#7F9139F6</color>
    <color name="brand_violet_soft">#B066E3</color>

    <!-- Khối demo chính: nền tông ẤM, viền tông LẠNH và dày 4dp — 2 gradient tương phản
         hẳn nhau thì mới thấy rõ chúng chạy 2 hướng khác nhau. -->
    <array name="hero_fill">
        <item>@color/brand_orange</item>
        <item>@color/brand_pink</item>
        <item>@color/brand_violet</item>
    </array>
    <array name="hero_stroke">
        <item>#7CF6A0</item>
        <item>#35D6E8</item>
        <item>#4C6FFF</item>
    </array>

    <!-- Nút CTA: nền gradient đặc, viền cùng tông sáng hơn -->
    <array name="cta_fill">
        <item>@color/brand_orange</item>
        <item>@color/brand_pink</item>
        <item>@color/brand_violet</item>
    </array>
    <array name="cta_stroke">
        <item>#00FFFFFF</item>
        <item>@color/white</item>
    </array>

    <!-- Thẻ kính: viền trắng nhạt dần, nền trắng rất mờ -->
    <array name="card_stroke">
        <item>#66FFFFFF</item>
        <item>#14FFFFFF</item>
    </array>
    <array name="card_fill">
        <item>#1AFFFFFF</item>
        <item>#05FFFFFF</item>
    </array>

    <!-- Item được chọn / thường / tắt -->
    <array name="item_selected_stroke">
        <item>@color/brand_violet_soft</item>
        <item>#FF9D8680</item>
    </array>
    <array name="item_selected_fill">
        <item>#33B066E3</item>
        <item>#0DB066E3</item>
    </array>
    <array name="item_idle_stroke">
        <item>#33FFFFFF</item>
    </array>
    <array name="item_disabled_stroke">
        <item>#14FFFFFF</item>
    </array>

    <!-- 2 trạng thái nền của khối demo. Khai alpha thẳng ở đây (không qua brand_*) để 3 mức
         xuyên thấu / mờ / đặc luôn khác nhau rõ, kể cả khi brand_* được chỉnh. -->
    <array name="hero_fill_soft">
        <item>#66D66341</item>
        <item>#66B7528D</item>
        <item>#669139F6</item>
    </array>
    <array name="hero_fill_solid">
        <item>#FFD66341</item>
        <item>#FFB7528D</item>
        <item>#FF9139F6</item>
    </array>
</resources>
